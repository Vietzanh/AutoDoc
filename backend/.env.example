# ── AutoDoc Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# JWT secret — use a long random string in production
SECRET_KEY=change-this-to-a-very-long-random-secret-string

# Database URL (SQLite default — file stored at data/autodoc.db)
DATABASE_URL=sqlite+aiosqlite:///./data/autodoc.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440
